      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook agent_activity"}]}
    ],
    "SubagentStart": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook agent_activity"}]}
    ],
    "SubagentStop": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook agent_activity"}]}
    ],
    "SessionStart": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook session_start"}]}
    ],
    "Stop": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook workflow_stop_guard"}]}
    ],
    "TeammateIdle": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook teammate_idle"}]}
    ],
    "TaskCompleted": [
      {"matcher": "", "hooks": [{"type": "command", "command": "stratus hook task_completed"}]}
    ]
  }
